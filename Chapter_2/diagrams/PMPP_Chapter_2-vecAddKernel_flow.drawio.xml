        <mxCell id="title" value="Complete Code &amp; Data-Flow Analysis &#8212; Chapter_2/vecAddKernel.cu" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#0b0b0b;" vertex="1" parent="1">
