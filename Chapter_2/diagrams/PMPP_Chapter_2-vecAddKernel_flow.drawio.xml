        <!-- ===================== LANES ===================== -->
        <mxCell id="laneMain" value="HOST (CPU) &#8212; main()" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;fontSize=14;fontStyle=1;fontColor=#184f95;fillColor=#eaf1fb;strokeColor=#2a78d6;strokeWidth=2;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="560" height="1910" as="geometry" />
        </mxCell>
        <mxCell id="laneVecAdd" value="HOST (CPU) &#8212; vecAdd()  [orchestrator function]" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;fontSize=14;fontStyle=1;fontColor=#184f95;fillColor=#dbe9fb;strokeColor=#2a78d6;strokeWidth=2;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="660" y="190" width="560" height="1910" as="geometry" />
        </mxCell>
        <mxCell id="laneDevice" value="DEVICE (GPU) &#8212; vecAddKernel &lt;&lt;&lt;40,256&gt;&gt;&gt; execution" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;fontSize=14;fontStyle=1;fontColor=#8a3413;fillColor=#fceee7;strokeColor=#eb6834;strokeWidth=2;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="1280" y="190" width="580" height="1910" as="geometry" />
        </mxCell>

        <!-- ===================== LANE 1: main() ===================== -->
        <mxCell id="m1" value="Start: main()" style="shape=terminator;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="220" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="int n = 10000;&lt;br&gt;int size = n * sizeof(float);  &#8212;&gt;  40,000 bytes&lt;br&gt;&lt;br&gt;&lt;i&gt;Why: the GPU driver and malloc() only understand raw byte counts, not &amp;quot;elements&amp;quot; &#8212; so every allocation converts element-count &#215; sizeof(type) into bytes up front.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="310" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="Allocate HOST memory:&lt;br&gt;A_h = (float*)malloc(size);&lt;br&gt;B_h = (float*)malloc(size);&lt;br&gt;C_h = (float*)malloc(size);&lt;br&gt;&lt;br&gt;&lt;i&gt;Why: these live in ordinary CPU RAM (the process heap). malloc() only knows about bytes, so the &lt;b&gt;(float*)&lt;/b&gt; cast tells the compiler how to interpret and index that raw block as an array of floats.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="for (i = 0; i &lt; n; i++) {&lt;br&gt;&amp;nbsp;&amp;nbsp;A_h[i] = 1.0f;&lt;br&gt;&amp;nbsp;&amp;nbsp;B_h[i] = 2.0f;&lt;br&gt;}&lt;br&gt;&lt;i&gt;Why: C_h is deliberately left uninitialized (garbage) here &#8212; it exists only to receive the GPU's answer later. If verification ran before vecAdd(), C_h would contain junk.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="600" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="vecAdd(A_h, B_h, C_h, n);&lt;br&gt;&lt;i&gt;A normal, synchronous C function call &#8212; main() halts here and waits for vecAdd() to fully return before continuing (unlike a kernel launch).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="70" y="770" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="int correct = 1;&lt;br&gt;for (i = 0; i &lt; n; i++) {&lt;br&gt;&amp;nbsp;&amp;nbsp;if (C_h[i] != 3.0f) {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;printf(&quot;Error at index %d...&quot;); correct=0; break;&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}&lt;br&gt;&lt;i&gt;Why 3.0f exactly (no epsilon/tolerance needed): 1.0f + 2.0f is exactly representable in IEEE-754 float &#8212; no rounding error, so a strict != comparison is safe here.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="900" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="correct == 1 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#cde2fb;strokeColor=#2a78d6;fontColor=#0b0b0b;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="1100" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m7a" value="printf(&quot;SUCCESS - All %d elements are correct.&quot;, n);" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1230" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="free(A_h);&lt;br&gt;free(B_h);&lt;br&gt;free(C_h);&lt;br&gt;&lt;br&gt;&lt;i&gt;Why: releases the CPU heap memory back to the OS. Note there is nothing to free on the device here &#8212; vecAdd() already cudaFree'd A_d/B_d/C_d before it returned.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1330" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="return 0; &#8212; End" style="shape=terminator;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="1500" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== LANE 2: vecAdd() ===================== -->
        <mxCell id="v1" value="vecAdd(A_h, B_h, C_h, n) &#8212; HOST function entry&lt;br&gt;&lt;br&gt;Runs entirely on the CPU. Its only job is to &lt;b&gt;drive&lt;/b&gt; the GPU: allocate device memory &#8594; copy inputs in &#8594; launch the kernel &#8594; copy the result back &#8594; free device memory." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="690" y="220" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="&lt;b&gt;Part 1 &#8212; Setup&lt;/b&gt;&lt;br&gt;float *A_d, *B_d, *C_d;&lt;br&gt;&lt;br&gt;&lt;i&gt;Why: these are just pointer VARIABLES sitting in CPU stack memory. Right now they are uninitialized &#8212; they will hold GPU (device) addresses only after cudaMalloc runs. The &lt;b&gt;_d&lt;/b&gt; suffix (device) vs &lt;b&gt;_h&lt;/b&gt; (host) is a naming convention, not a language rule &#8212; it's how the programmer tracks which memory space each pointer is valid in.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="410" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="int size = n * sizeof(float);&lt;br&gt;&lt;i&gt;Recomputed locally &#8212; vecAdd() only received n, not the byte size main() already computed.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="600" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="cudaMalloc((void**)&amp;A_d, size);&lt;br&gt;cudaMalloc((void**)&amp;B_d, size);&lt;br&gt;cudaMalloc((void**)&amp;C_d, size);&lt;br&gt;&lt;br&gt;&lt;i&gt;Why (void**): cudaMalloc must WRITE the new GPU address into your pointer variable. To modify a variable through a function call, C needs the address OF that variable &#8212; i.e. a pointer to the pointer. It's typed void** because cudaMalloc is type-agnostic; the cast tells the compiler to accept any pointer type there. Each call reserves &lt;b&gt;size&lt;/b&gt; bytes in DEVICE GLOBAL MEMORY (VRAM) &#8212; completely separate physical RAM from the host.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="720" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="cudaMemcpy(A_d, A_h, size, cudaMemcpyHostToDevice);&lt;br&gt;cudaMemcpy(B_d, B_h, size, cudaMemcpyHostToDevice);&lt;br&gt;&lt;br&gt;&lt;i&gt;Why: host (CPU) and device (GPU) have physically separate DRAM. The GPU cannot reach into main()'s heap on its own &#8212; every byte has to be explicitly shipped across the PCIe bus. C_h/C_d are NOT copied here: there is no output yet, and copying it would be wasted bandwidth.&lt;br&gt;(see the Memory Map diagram below)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="960" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="&lt;b&gt;Part 2 &#8212; Kernel Launch Configuration&lt;/b&gt;&lt;br&gt;int threadsPerBlock = 256;&lt;br&gt;int blocksPerGrid = (n + threadsPerBlock - 1) / threadsPerBlock;&lt;br&gt;= (10000 + 255) / 256 = &lt;b&gt;40&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Why the &amp;quot;+255&amp;quot;: plain integer division n/256 TRUNCATES (10000/256 = 39.06 &#8594; 39), which would drop the last 16 elements entirely. Adding (threadsPerBlock-1) before dividing forces a round-UP (ceiling) division, guaranteeing every element gets a thread even when n is not an exact multiple of 256.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="1200" width="500" height="220" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="vecAddKernel&amp;lt;&amp;lt;&amp;lt;blocksPerGrid, threadsPerBlock&amp;gt;&amp;gt;&amp;gt;(A_d, B_d, C_d, n);&lt;br&gt;&lt;i&gt;(async &#8212; this line returns to the CPU immediately)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Why: &amp;lt;&amp;lt;&amp;lt;grid, block&amp;gt;&amp;gt;&amp;gt; is CUDA's launch syntax &#8212; here it means &amp;quot;create 40 blocks of 256 threads&amp;quot; = 10,240 threads, all running the same kernel code. Launching is asynchronous: the CPU queues the work and moves on to the next C++ statement without waiting.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="690" y="1460" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="cudaMemcpy(C_h, C_d, size, cudaMemcpyDeviceToHost);&lt;br&gt;&lt;br&gt;&lt;i&gt;Why this line BLOCKS: on the default stream, cudaMemcpy is implicitly synchronizing &#8212; the CPU stalls here until every one of the 10,240 threads launched above has finished, THEN the driver copies the finished C_d buffer back across PCIe into C_h.&lt;br&gt;(see the Memory Map diagram below)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a3aa7;strokeColor=#382b80;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="690" y="1680" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="&lt;b&gt;Part 3 &#8212; Cleanup&lt;/b&gt;&lt;br&gt;cudaFree(A_d);&lt;br&gt;cudaFree(B_d);&lt;br&gt;cudaFree(C_d);&lt;br&gt;&lt;br&gt;&lt;i&gt;Why: returns the three device allocations to the GPU's memory pool. Skipping this would leak VRAM for the lifetime of the process (or until the CUDA context is destroyed).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="1900" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="return;  (void function) &#8212; back to main()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="690" y="2080" width="500" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== LANE 3: device kernel ===================== -->
        <mxCell id="d0" value="GPU receives the launch request&lt;br&gt;&amp;lt;&amp;lt;&amp;lt;40, 256&amp;gt;&amp;gt;&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#8a3413;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="220" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Grid = 40 blocks &#215; Block = 256 threads/block&lt;br&gt;= &lt;b&gt;10,240 threads&lt;/b&gt; created&lt;br&gt;(only 10,000 elements exist &#8212; 240 will be idle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#8a3413;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="350" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Every thread runs the SAME instructions (SIMT)&lt;br&gt;vecAddKernel(A_d, B_d, C_d, n)&lt;br&gt;independently, at (mostly) the same time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#8a3413;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="520" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="int i = blockIdx.x * blockDim.x + threadIdx.x;&lt;br&gt;&lt;br&gt;&lt;i&gt;&lt;b&gt;blockIdx.x&lt;/b&gt;: which block this thread lives in (0..39)&lt;br&gt;&lt;b&gt;blockDim.x&lt;/b&gt;: threads per block, fixed at 256&lt;br&gt;&lt;b&gt;threadIdx.x&lt;/b&gt;: this thread's slot inside its block (0..255)&lt;br&gt;&lt;br&gt;Why: this formula flattens the 2-level hardware hierarchy (block, thread) into ONE global index, so all 10,240 threads get a unique i in [0, 10239] mapping onto the flat 1-D arrays A/B/C.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#8a3413;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="680" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="i &lt; n ?&lt;br&gt;(i &lt; 10000)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fbe0cf;strokeColor=#eb6834;fontColor=#0b0b0b;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1410" y="950" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="C[i] = A[i] + B[i];&lt;br&gt;&lt;br&gt;Reads A_d[i], B_d[i] from device global memory, adds them, writes the sum into C_d[i]. This is the ONLY line of actual work in the whole program." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#8a3413;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1310" y="1100" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="Do nothing &#8212; thread exits.&lt;br&gt;&lt;br&gt;Guards against reading/writing past index 9999 into memory the GPU never allocated for A/B/C." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e34948;strokeColor=#a12a2a;fontColor=#ffffff;fontSize=12;arcSize=6;align=left;spacingLeft=8;" vertex="1" parent="1">
