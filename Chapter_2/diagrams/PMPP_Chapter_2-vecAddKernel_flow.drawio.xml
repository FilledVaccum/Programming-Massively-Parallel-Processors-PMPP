        <mxCell id="subtitle" value="CUDA vector addition C = A + B &#8212; every host/device step, every variable's journey across the PCIe boundary, and the reasoning behind each line" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#52514e;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1800" height="22" as="geometry" />
        </mxCell>
        <mxCell id="fileOverview" value="&lt;b&gt;Three parts of this one file:&lt;/b&gt;  (1) &lt;b&gt;__global__ vecAddKernel&lt;/b&gt; &#8212; the parallel program that EVERY GPU thread executes (Device).  (2) &lt;b&gt;vecAdd()&lt;/b&gt; &#8212; a normal C function that runs on the CPU and orchestrates the whole GPU workflow: allocate device memory &#8594; copy inputs in &#8594; launch the kernel &#8594; copy the result back &#8594; free device memory (Host).  (3) &lt;b&gt;main()&lt;/b&gt; &#8212; allocates/initializes the data, calls vecAdd() once, then verifies every result (Host)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d4a017;fontColor=#52514e;fontSize=12;arcSize=4;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1820" height="52" as="geometry" />
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="lg1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#184f95;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="14" height="14" as="geometry" /></mxCell>
        <mxCell id="lgl1" value="Host (CPU) &#8212; sequential, one instruction at a time" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="60" y="138" width="330" height="18" as="geometry" /></mxCell>
        <mxCell id="lg2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eb6834;strokeColor=#8a3413;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="14" height="14" as="geometry" /></mxCell>
        <mxCell id="lgl2" value="Device (GPU) &#8212; run by thousands of threads at once" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="420" y="138" width="340" height="18" as="geometry" /></mxCell>
        <mxCell id="lg3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a3aa7;strokeColor=#382b80;" vertex="1" parent="1"><mxGeometry x="780" y="140" width="14" height="14" as="geometry" /></mxCell>
        <mxCell id="lgl3" value="Blocking / implicitly-synchronizing call" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="800" y="138" width="280" height="18" as="geometry" /></mxCell>
