        <mxCell id="lg5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#2f9e44;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="14" height="14" as="geometry" /></mxCell>
        <mxCell id="lgl5" value="Device global memory (VRAM)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="60" y="162" width="330" height="18" as="geometry" /></mxCell>
        <mxCell id="lg6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d4a017;dashed=1;" vertex="1" parent="1"><mxGeometry x="400" y="164" width="14" height="14" as="geometry" /></mxCell>
        <mxCell id="lgl6" value="&quot;Why&quot; note &#8212; the reasoning behind the code" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="420" y="162" width="340" height="18" as="geometry" /></mxCell>
